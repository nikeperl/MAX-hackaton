# Локальное демо: данные изолированы для каждого браузера, отправки в MAX нет.
DEMO_MODE=true
PORT=3001
DATABASE_PATH=./data/vovremya.sqlite
# Для реального MAX: DEMO_MODE=false, NODE_ENV=production
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=
MAX_WEBHOOK_SECRET=
APP_URL=https://your-domain.example
# Только для варианта запуска без домена (compose.ip.yaml):
# PUBLIC_IP=203.0.113.10
MAX_API_URL=https://platform-api2.max.ru
