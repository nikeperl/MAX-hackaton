# Local development defaults. Docker demo does not require this file.
DEMO_MODE=true
PORT=3001
DATABASE_PATH=./data/vovremya.sqlite
# Live MAX: set DEMO_MODE=false and NODE_ENV=production.
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=
MAX_WEBHOOK_SECRET=
APP_URL=https://your-domain.example
# HTTPS domain deployment (compose.https.yaml):
APP_DOMAIN=your-domain.example
# IP deployment (compose.ip.yaml):
# PUBLIC_IP=203.0.113.10
MAX_API_URL=https://platform-api2.max.ru
